{
  "name": "dsh-init-plugin",
  "version": "0.1.5-rc.1.2",
  "private": true,
  "type": "module",
  "description": "Deprecated Codex-style /init command for initializing repository AGENTS.md files",
  "main": "./src/host.mjs",
  "exports": {
    ".": "./src/host.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "check": "node --check src/host.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-llm": "0.1.5-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-commands": "0.1.5-rc.1"
  }
}
