{
  "name": "dsh-project-mcp-plugin",
  "version": "0.1.5-rc.2.4",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Project-scoped MCP servers for DeepSeek Harness Agents",
  "main": "./src/host.mjs",
  "exports": {
    ".": "./src/host.mjs",
    "./config": "./src/config.mjs",
