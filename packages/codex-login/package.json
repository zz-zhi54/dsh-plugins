{
  "name": "dsh-codex-login-plugin",
  "version": "0.1.5-rc.1.3",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Temporary ChatGPT and Codex OAuth login plugin for DeepSeek Harness Web",
  "main": "./src/host.mjs",
  "exports": {
    ".": "./src/host.mjs",
    "./client": "./src/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "check": "node --check src/host.mjs && node --check src/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings-models"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-authorization": "0.1.5-rc.1"
  }
}
